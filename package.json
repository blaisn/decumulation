{
  "name": "decumulation",
  "version": "0.1.0",
  "private": true,
  "description": "Décumulation : plan de décaissement pour couple de retraités (Québec)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/compare-strategies.ts",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "main": "dist/electron/main.js",
  "build": {
    "appId": "ca.local.decumulation",
    "productName": "Décumulation",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Decumulation-portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Decumulation-installateur-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
